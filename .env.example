# BLINK environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never be
# committed. Every value below is a placeholder: BLINK ships with no credentials.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# testnet | mainnet. Mainnet is opt-in and requires explicit configuration.
ZCASH_NETWORK=testnet
# Must match ZCASH_NETWORK. Used by the web app to label the session.
NEXT_PUBLIC_NETWORK=testnet

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Public base URL of the web app. Share links are built from this.
APP_BASE_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API.
BLINK_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Generate a strong password and keep it out of source control.
DATABASE_URL=postgres://blink:CHANGE_ME@127.0.0.1:5432/blink

# ---------------------------------------------------------------------------
# Encryption of recipient addresses at rest (AES-256-GCM)
# ---------------------------------------------------------------------------
# 32-byte key, 64 hex characters. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLINK_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Authoritative Zcash engine (Rust service)
# ---------------------------------------------------------------------------
# When set, address and ZIP 321 validation is confirmed by the blink-zcash
# service, which wraps the official Zcash Rust crates.
BLINK_ZCASH_SERVICE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Blockchain verification
# ---------------------------------------------------------------------------
# none | lightwalletd | node-rpc
#   none         -> BLINK reports UNKNOWN and never fabricates a transaction.
#   node-rpc     -> uses a zcashd JSON-RPC endpoint (ZCASH_RPC_* below).
#   lightwalletd -> uses the lightwalletd CompactTxStreamer gRPC API. It fetches
#                   the transaction the payer reported, decodes it with the
#                   authoritative Zcash engine, and reports confirmations. It
#                   requires BLINK_ZCASH_SERVICE_URL to be set.
BLINK_VERIFICATION_PROVIDER=none
BLINK_CONFIRMATIONS_REQUIRED=1

# Full-node JSON-RPC (only when BLINK_VERIFICATION_PROVIDER=node-rpc).
ZCASH_RPC_URL=
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=

# lightwalletd gRPC endpoint (only when BLINK_VERIFICATION_PROVIDER=lightwalletd).
# Point this at a lightwalletd-compatible endpoint you trust or operate for the
# selected network: a testnet endpoint (chainName "test") when ZCASH_NETWORK is
# testnet, a mainnet endpoint (chainName "main") when it is mainnet. BLINK does
# not hard-code or endorse any third-party endpoint; validate one by calling
# GetLightdInfo and checking that chainName matches the selected network before
# relying on it. The provider refuses to observe if the endpoint serves a
# different network than the one configured.
# Plain host:port implies an insecure channel; an https:// prefix enables TLS.
BLINK_LIGHTWALLETD_URL=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
BLINK_RATE_LIMIT_MAX=120
BLINK_RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
